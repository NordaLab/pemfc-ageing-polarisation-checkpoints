cff-version: 1.2.0
message: If you use this dataset, please cite it as below.
type: dataset
title: "Polarisation curves at ageing checkpoints for 57 proton exchange membrane fuel cells from 4 laboratories"
version: "1.4.0"
date-released: "2026-10-03"
authors:
  - family-names: "Xu"
    given-names: "Yueqiang"
    affiliation: "University of Oulu"
    orcid: "https://orcid.org/0000-0002-3528-423X"
license: "CC-BY-4.0"
repository: "https://github.com/NordaLab/pemfc-ageing-polarisation-checkpoints"
url: "https://github.com/NordaLab/pemfc-ageing-polarisation-checkpoints"
keywords:
  - "proton exchange membrane fuel cell"
  - "PEM fuel cell"
  - "durability"
  - "degradation"
